# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_API_KEY: Optional SERVER-SIDE ONLY key for Google Maps Platform Geocoding (never client-bundled).
GOOGLE_MAPS_API_KEY=

# ADMIN_EMAILS: Comma-separated list of authorized administrator emails for RBAC verification.
ADMIN_EMAILS=

# NOTIFICATION_WEBHOOK_URL: Optional server-side Slack or Discord webhook endpoint for dispatching alerts.
NOTIFICATION_WEBHOOK_URL=

# VITE_FIREBASE_API_KEY: Public Firebase *browser* (web) API key. Required for Google Sign-In/Firestore.
# Read by Vite at BUILD time and embedded in the client bundle, so it is not a secret.
# Restrict it in Google Cloud Console (APIs & Services > Credentials) by HTTP referrer
# (your Cloud Run domain, localhost) and by API (Identity Toolkit, Token Service, Firestore).
# Never commit the real value. Never put GEMINI_API_KEY or GOOGLE_MAPS_API_KEY in a VITE_ variable.
VITE_FIREBASE_API_KEY=

# Optional overrides for non-sensitive values already present in firebase-applet-config.json.
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_FIRESTORE_DATABASE_ID=
