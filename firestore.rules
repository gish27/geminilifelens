rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Zero Insecure Defaults: Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for security and RBAC
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // User Data Isolation: Owner-bound path checking
    match /users/{userId}/interactions/{interactionId} {
      allow read, write: if isOwner(userId);
    }

    // RBAC: Roles lookup for administrators (read-only for authenticated users to verify permissions; writes forbidden except via Admin SDK)
    match /roles_admin/{adminId} {
      allow read: if isAuthenticated() && request.auth.uid == adminId;
      allow write: if false;
    }
  }
}

